<?xml version="1.0" encoding="utf-8"?>
<!-- A · Palco do YouTube: o YouTube ocupa quase metade do painel. -->
<com.calivix.carro.Escala xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="1792px" android:layout_height="700px" android:orientation="horizontal" android:padding="28px" android:background="#8C050810">

    <FrameLayout android:layout_width="800px" android:layout_height="match_parent">
        <include layout="@layout/yt_alto" />
    </FrameLayout>

    <LinearLayout android:layout_width="480px" android:layout_height="match_parent" android:layout_marginStart="16px" android:orientation="vertical">
        <LinearLayout android:id="@+id/relogio_card" android:layout_width="match_parent" android:layout_height="0px" android:layout_weight="1" android:background="@drawable/bg_card"
            android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="34px" android:paddingEnd="24px">
            <TextView android:id="@+id/relogio" style="@style/Texto.Numero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="112px" />
            <TextView android:id="@+id/data" style="@style/Texto.Fraco" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12px" android:textSize="26px" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18px">
                <TextView android:id="@+id/rede" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip_azul" android:textColor="#CFE0FF" />
                <TextView android:id="@+id/vpn" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10px" android:background="@drawable/bg_chip_verde" android:textColor="#9FF0C4" />
            </LinearLayout>
            <HorizontalScrollView android:id="@+id/grupos_rolagem" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12px" android:scrollbars="none" android:overScrollMode="never" android:fadingEdgeLength="40px" android:requiresFadingEdge="horizontal">
                <LinearLayout android:id="@+id/grupos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" />
            </HorizontalScrollView>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="200px" android:layout_marginTop="16px">
            <include layout="@layout/musica" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="0px" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="16px" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="236px" android:background="@drawable/bg_card" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/velocidade" style="@style/Texto.Numero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="104px" android:text="0" />
            <TextView style="@style/Texto.Fraco" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6px" android:textSize="24px" android:text="km/h" />
        </LinearLayout>
        <GridLayout android:id="@+id/apps" android:layout_width="match_parent" android:layout_height="0px" android:layout_weight="1" android:layout_marginTop="16px"
            android:columnCount="2" android:rowCount="2" android:tag="bloco" />
    </LinearLayout>
</LinearLayout>
</com.calivix.carro.Escala>
