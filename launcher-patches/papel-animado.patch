diff --git a/launcher/app/src/main/java/com/gathin/tvhome/WallpaperVideo.java b/launcher/app/src/main/java/com/gathin/tvhome/WallpaperVideo.java
new file mode 100644
index 00000000..59b6c924
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/WallpaperVideo.java
@@ -0,0 +1,198 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Matrix;
+import android.graphics.SurfaceTexture;
+import android.media.MediaMetadataRetriever;
+import android.media.MediaPlayer;
+import android.util.Log;
+import android.view.Surface;
+import android.view.TextureView;
+import android.view.View;
+
+import java.io.File;
+import java.util.Locale;
+
+/**
+ * Animated wallpapers: an .mp4 in the collection plays muted and looped behind Home. The video's first frame is
+ * decoded as an ordinary picture (the poster) so Home and the clock screensaver draw it at once; the video then
+ * starts over it and pauses whenever Home is hidden. A file the TV cannot play keeps showing the poster.
+ */
+final class WallpaperVideo implements TextureView.SurfaceTextureListener {
+    /** Videos may be bigger than pictures: a 20 s 1080p loop is 5-15 MB. */
+    static final long MAX_BYTES = 40L * 1024 * 1024;
+
+    /** Where the poster comes from and playback starts: the middle of the loop, past any opening from black. */
+    static long posterMs(long durationMs) {
+        return durationMs > 0 ? Math.min(10_000L, durationMs / 2) : 0;
+    }
+
+    static boolean isVideo(File file) {
+        return file != null && file.getName().toLowerCase(Locale.ROOT).endsWith(".mp4");
+    }
+
+    /** The first frame, scaled to cover the screen (never bigger than it), or null if the file is not a video. */
+    static Bitmap poster(File file, int screenW, int screenH) {
+        MediaMetadataRetriever retriever = new MediaMetadataRetriever();
+        try {
+            retriever.setDataSource(file.getPath());
+            String d = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION);
+            long at = posterMs(d == null ? 0 : Long.parseLong(d));
+            Bitmap frame = retriever.getFrameAtTime(at * 1000, MediaMetadataRetriever.OPTION_CLOSEST_SYNC);
+            if (frame == null) return null;
+            int w = frame.getWidth(), h = frame.getHeight();
+            if (w <= screenW && h <= screenH) return frame;
+            float s = Math.max((float) screenW / w, (float) screenH / h);
+            Bitmap scaled = Bitmap.createScaledBitmap(frame, Math.max(1, Math.round(w * s)), Math.max(1, Math.round(h * s)), true);
+            if (scaled != frame) frame.recycle();
+            return scaled;
+        } catch (Exception | OutOfMemoryError failure) {
+            return null;
+        } finally {
+            try {
+                retriever.release();
+            } catch (Exception ignored) {
+                // nothing to release
+            }
+        }
+    }
+
+    final TextureView view;
+    private Surface surface;
+    private MediaPlayer player;
+    private File file;
+    private boolean wanted;
+
+    WallpaperVideo(Context context) {
+        view = new TextureView(context);
+        view.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        view.setFocusable(false);
+        // Not alpha 0: a fully transparent TextureView is never drawn, so its surface would never be created.
+        // Until the first frame it draws nothing, and the poster underneath shows through.
+        view.setVisibility(View.INVISIBLE);
+        view.setSurfaceTextureListener(this);
+    }
+
+    /** Plays this file (null stops and hides the video, leaving the picture underneath). */
+    void play(File next) {
+        if (next == null) {
+            file = null;
+            release();
+            view.setVisibility(View.INVISIBLE);
+            return;
+        }
+        view.setVisibility(View.VISIBLE);
+        if (next.equals(file) && player != null) {
+            resume();
+            return;
+        }
+        file = next;
+        release();
+        wanted = true;
+        if (surface != null) open();
+    }
+
+    void resume() {
+        wanted = true;
+        if (player != null) {
+            try {
+                if (!player.isPlaying()) player.start();
+            } catch (IllegalStateException failure) {
+                release();
+                if (surface != null && file != null) open();
+            }
+        } else if (surface != null && file != null) {
+            open();
+        }
+    }
+
+    void pause() {
+        wanted = false;
+        if (player == null) return;
+        try {
+            if (player.isPlaying()) player.pause();
+        } catch (IllegalStateException ignored) {
+            // released meanwhile
+        }
+    }
+
+    /** Frees the decoder; the poster stays. play() or resume() opens it again. */
+    void release() {
+        if (player != null) {
+            MediaPlayer old = player;
+            player = null;
+            try {
+                old.release();
+            } catch (Exception ignored) {
+                // already released
+            }
+        }
+    }
+
+    private void open() {
+        File target = file;
+        if (target == null || surface == null) return;
+        MediaPlayer mp = new MediaPlayer();
+        player = mp;
+        try {
+            mp.setDataSource(target.getPath());
+            mp.setSurface(surface);
+            mp.setLooping(true);
+            mp.setVolume(0f, 0f);
+            mp.setOnVideoSizeChangedListener((p, w, h) -> cover(w, h));
+            mp.setOnInfoListener((p, what, extra) -> {
+                return false;
+            });
+            mp.setOnErrorListener((p, what, extra) -> {
+                Log.w("TvHome.Wallpaper", "Video wallpaper failed (" + what + "/" + extra + "): " + target.getName());
+                if (p == player) release();
+                return true;
+            });
+            mp.setOnPreparedListener(p -> {
+                if (p != player) return;
+                cover(p.getVideoWidth(), p.getVideoHeight());
+                p.seekTo((int) posterMs(p.getDuration()));   // continues from the poster's frame
+                if (wanted) p.start();
+            });
+            mp.prepareAsync();
+        } catch (Exception failure) {
+            Log.w("TvHome.Wallpaper", "Cannot open video wallpaper: " + target.getName(), failure);
+            release();
+        }
+    }
+
+    /** centerCrop for the video, like the pictures. */
+    private void cover(int videoW, int videoH) {
+        int w = view.getWidth(), h = view.getHeight();
+        if (videoW <= 0 || videoH <= 0 || w <= 0 || h <= 0) return;
+        float s = Math.max((float) w / videoW, (float) h / videoH);
+        Matrix m = new Matrix();
+        m.setScale(videoW * s / w, videoH * s / h, w / 2f, h / 2f);
+        view.setTransform(m);
+    }
+
+    @Override
+    public void onSurfaceTextureAvailable(SurfaceTexture texture, int width, int height) {
+        surface = new Surface(texture);
+        if (wanted && file != null && player == null) open();
+    }
+
+    @Override
+    public void onSurfaceTextureSizeChanged(SurfaceTexture texture, int width, int height) {
+        if (player != null) cover(player.getVideoWidth(), player.getVideoHeight());
+    }
+
+    @Override
+    public boolean onSurfaceTextureDestroyed(SurfaceTexture texture) {
+        release();
+        if (surface != null) surface.release();
+        surface = null;
+        return true;
+    }
+
+    @Override
+    public void onSurfaceTextureUpdated(SurfaceTexture texture) {
+        // nothing to do per frame
+    }
+}
